# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where quote requests are delivered
CONTACT_TO_EMAIL=info@sibouagro.com
# Optional: verified sender. Defaults to Resend's test sender (only delivers to your own Resend account email)
CONTACT_FROM_EMAIL="Sibou Agro Website <quotes@sibouagro.com>"
# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sibouagro.com
